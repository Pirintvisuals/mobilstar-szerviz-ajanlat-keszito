# Másold .env.local néven. Vercelen ugyanezek a nevek a Project -> Settings ->
# Environment Variables alatt.

# Fuchs olajválasztó (Olyslager adatbázis). Nélküle a keresés nem működik.
OLY_SUBSCRIPTION=
OLY_DATASET=fuchs_eu

# Alvázszám -> alkatrész fül (TecDoc-teszt, RapidAPI "Auto Parts Catalog").
# Csak tesztre / demóra - fizető ügyfélnél licencelt TecDoc kell.
RAPIDAPI_KEY=

# Egyszerű jelszó a felülethez (Vercel: Environment Variables). Ha üres, nincs jelszó.
APP_PASSWORD=
# Tanult adat tárolása Vercelen: Upstash Redis a Vercel Marketplace-ről.
# Bekötéskor a Vercel magától beállítja ezt a kettőt.
KV_REST_API_URL=
KV_REST_API_TOKEN=
